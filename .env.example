DB_HOST=localhost
DB_PORT=5432
DB_NAME=kalibra_db
DB_USER=quedena
DB_PASSWORD=                  # obligatorio — sin default

SERVER_PORT=8080

# Clave de firma del JWT propio emitido por el módulo iam (issuer local).
# Generar con: openssl rand -base64 64
JWT_SECRET=                   # obligatorio — sin default
JWT_EXPIRATION_MINUTES=30

# Origen del frontend que consumirá esta API (necesario para CORS + cookie de sesión).
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Almacenamiento provisional del material curricular (adaptador de sistema de archivos).
# El proveedor definitivo (S3, Blob, etc.) está pendiente; los archivos nunca van a PostgreSQL.
MATERIALS_STORAGE_DIR=./storage/materials
MATERIALS_MAX_FILE_SIZE=10MB

# Cada cuánto se reintenta la ingesta de materiales pendientes (ISO-8601).
INGESTION_RECONCILIATION_DELAY=PT5M
