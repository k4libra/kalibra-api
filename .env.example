# ── Credenciales externas: lo único que falta para operar el circuito completo ──────────────
# Proveedores de IA del adaptive engine (docker compose se los pasa al contenedor del engine).
DEEPSEEK_API_KEY=             # generación y verificación de ejercicios
MISTRAL_API_KEY=              # extracción (OCR) del material curricular

# Cloudflare R2: bucket privado donde se guarda el material curricular. El engine lo lee con
# una URL prefirmada de corta duración. Token de API de R2 con permiso de lectura y escritura.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Secretos propios ───────────────────────────────────────────────────────────────────────
DB_PASSWORD=                  # obligatorio — sin default
# Clave de firma del JWT propio emitido por el módulo iam (issuer local).
# Generar con: openssl rand -base64 64
JWT_SECRET=                   # obligatorio — sin default

# ── Todo lo demás tiene un valor por defecto ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kalibra_db
DB_USER=quedena

SERVER_PORT=8080
JWT_EXPIRATION_MINUTES=30

# Origen del frontend que consumirá esta API (necesario para CORS + cookie de sesión).
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Almacenamiento del material curricular: r2 (requerido para la ingesta) o filesystem
# (solo desarrollo local; el engine no puede leer esos archivos y el material queda pendiente).
STORAGE_PROVIDER=r2
MATERIALS_STORAGE_DIR=./storage/materials
MATERIALS_MAX_FILE_SIZE=10MB
R2_URL_VALIDITY=PT15M

# Adaptive engine: REST para la estimación de dominio, cola Redis para extracción y generación.
ENGINE_BASE_URL=http://localhost:8000
ENGINE_REQUEST_TIMEOUT=PT5S
ENGINE_TASK_TIMEOUT=PT4M
REDIS_URL=redis://localhost:6379/0
GAP_MAP_CACHE_TTL=PT10M

# Cada cuánto se reintenta la ingesta de materiales pendientes (ISO-8601).
INGESTION_RECONCILIATION_DELAY=PT5M
